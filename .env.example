# Frontend host
TTS_CLIPS_BACKEND_URL=http://tts-gpu.corp.example:8765

# Backend host. Use the GPU server's internal IPv4 address.
# Loopback is a safe default until the corporate firewall is configured.
TTS_CLIPS_BACKEND_BIND=127.0.0.1
TTS_CLIPS_ROOT=/srv/tts-clips
# Set to 1 for a pre-seeded server without Internet access.
HF_HUB_OFFLINE=0
