# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json index.html ./
COPY web/ ./web/
RUN npm run build

FROM nginx:stable-alpine@sha256:caf4e1e032a20f9c3c5e28fc7f25ffd768ad8677b4975c54193075997b3a97e3
COPY --from=build /build/dist/ /usr/share/nginx/html/
COPY docker/frontend.conf.template /etc/nginx/templates/default.conf.template
COPY --chmod=0755 docker/15-validate-backend.sh /docker-entrypoint.d/15-validate-backend.sh
ENV NGINX_ENVSUBST_FILTER=^TTS_CLIPS_BACKEND_URL$
EXPOSE 80
